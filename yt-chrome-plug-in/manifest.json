{
  "manifest_version": 3,
  "name": "YouTube Sentiment Analysis",
  "version": "1.0",
  "description": "Analyzes YouTube video comments using a machine learning sentiment model.",

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": [
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:5001/*",
    "http://localhost:5001/*",
    "https://www.googleapis.com/*",
    "https://www.youtube.com/*"
  ]
}